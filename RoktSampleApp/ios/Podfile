ENV['RCT_NEW_ARCH_ENABLED'] ||= '1'
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# The Rokt iOS SDK comes from Swift Package Manager by default (README › Swift Package Manager);
# ROKT_USE_COCOAPODS=1 takes it from CocoaPods instead. The setting must come before `target`, which
# evaluates the podspec. Swift Package Manager mode adds the package to RoktSampleApp.xcodeproj: discard
# that change before switching to CocoaPods, or the app links both copies (Debug builds then show an
# error on launch).
$RNRoktDisableSPM = ENV['ROKT_USE_COCOAPODS'] == '1'

if $RNRoktDisableSPM
  # Rokt SDK 5.0 source-based pods need dynamic framework linking
  # to avoid module map redefinition errors with React Native's module system
  pre_install do |installer|
    installer.pod_targets.each do |pod|
      if ['Rokt-Widget', 'RoktContracts', 'RoktUXHelper', 'DcuiSchema'].include?(pod.name)
        def pod.build_type;
          Pod::BuildType.new(:linkage => :dynamic, :packaging => :framework)
        end
      end
    end
  end
end

target 'RoktSampleApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Uncomment to enable Shoppable Ads payment extension. With Swift Package Manager, set
  # $RNRoktSPMPackages = ['RoktPaymentExtension'] above instead.
  # pod 'RoktPaymentExtension' if $RNRoktDisableSPM

  target 'RoktSampleAppTests' do
    inherit! :search_paths
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26.4+ enforces stricter C++20 consteval rules that break fmt 11.0.2
    # (bundled with React Native 0.81). Compile fmt in C++17 mode only.
    # https://github.com/facebook/react-native/issues/55601
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'

      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end

    unless $RNRoktDisableSPM
      # The unit tests compile against the SDK's generated headers but never link the SDK: the host
      # app does. Point them at the directory where Xcode writes those headers.
      spm_headers = '"$(OBJROOT)/GeneratedModuleMaps-$(PLATFORM_NAME)"'
      installer.aggregate_targets.select { |t| t.name.end_with?('-RoktSampleAppTests') }.each do |t|
        t.xcconfigs.each do |build_config, xcconfig|
          xcconfig.attributes['HEADER_SEARCH_PATHS'] = "#{xcconfig.attributes['HEADER_SEARCH_PATHS']} #{spm_headers}"
          xcconfig.save_as(t.xcconfig_path(build_config))
        end
      end
    end
  end
end
